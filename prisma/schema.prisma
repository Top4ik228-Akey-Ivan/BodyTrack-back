generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workouts     Workout[]
  exercises    Exercise[]
  @@map("users")
}

model Workout {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  desc      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks     WorkoutWeek[]

  @@map("workouts")
}

model Exercise {
  id          Int         @id @default(autoincrement())
  userId      Int?
  title       String
  desc        String?
  muscleGroup MuscleGroup
  isPublic    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user     User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks    WorkoutExerciseWeek[]

  @@map("exercises")
}

model WorkoutWeek {
  id        Int      @id @default(autoincrement())
  workoutId Int
  weekIndex Int
  createdAt DateTime @default(now())

  workout   Workout                 @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises WorkoutExerciseWeek[]

  @@unique([workoutId, weekIndex])
}

model WorkoutExerciseWeek {
  id            Int @id @default(autoincrement())
  workoutWeekId Int
  exerciseId    Int
  orderIndex    Int

  workoutWeek WorkoutWeek @relation(fields: [workoutWeekId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets        SetWeek[]

  @@unique([workoutWeekId, orderIndex])
  @@unique([workoutWeekId, exerciseId]) // запрещаем дубли упражнений в одной неделе
}

model SetWeek {
  id                    Int    @id @default(autoincrement())
  workoutExerciseWeekId  Int
  weight                Float?
  reps                  Int
  orderIndex            Int

  workoutExerciseWeek WorkoutExerciseWeek @relation(fields: [workoutExerciseWeekId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseWeekId, orderIndex])
}
